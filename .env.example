# Aion: variáveis de ambiente. Copie para `.env` (ignorado pelo Git) no desenvolvimento local.
# Em produção, cada serviço recebe as SUAS variáveis pelo painel do Easypanel (ver docs/operacao.md).
# NUNCA coloque valores reais neste arquivo: ele é versionado.

# ---------------------------------------------------------------------------------------------
# api
# ---------------------------------------------------------------------------------------------
# Obrigatórias: sem elas a API não inicia (o log cita só o nome da variável, nunca o valor).
DATABASE_URL=
AION_OWNER_EMAIL=
# De 12 a 256 caracteres. Fica em texto no ambiente (decisão AUTH-02); trocá-la e reiniciar encerra todas as sessões.
AION_OWNER_PASSWORD=
# 32 bytes em base64 ou hex. Gere com: openssl rand -base64 32
# Criptografa as chaves de terceiros e o segredo TOTP. GUARDE UMA CÓPIA FORA DO VPS: sem ela, o banco restaurado
# não consegue decifrar nada.
AION_MASTER_KEY=

# Opcionais
# Teto global de JPEGs e texto extraído armazenados, em MB; padrão 1024. Validado somente pela API.
AION_ATTACHMENTS_MAX_TOTAL_MB=1024
# Origin exato da web (base do CSRF, HSTS e CSP). Obrigatória em produção (sem ela a api não sobe); fora dela, http://localhost:3000.
# AION_PUBLIC_ORIGIN=https://aion.exemplo.com
# Proxies em que a API confia para ler o IP do cliente em X-Forwarded-For (IP/CIDR ou loopback, linklocal, uniquelocal).
# Padrão: loopback,uniquelocal em produção (rede interna do Easypanel); vazio em dev.
# AION_TRUSTED_PROXIES=loopback,uniquelocal
# Só com pedido explícito do dono: deixa uma migration marcada como destrutiva rodar no deploy.
# AION_ALLOW_DESTRUCTIVE_MIGRATIONS=false
# Destinos de saída fixos dos serviços de terceiros (chaves do OpenCode Go, da Anthropic, do Composio e a opcional da Parallel entram pela tela de
# Configurações, nunca por variável). Só https (http apenas em loopback, para servidores falsos de teste).
# AION_OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
# AION_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# AION_COMPOSIO_BASE_URL=https://backend.composio.dev/api/v3
# AION_PARALLEL_BASE_URL=https://search.parallel.ai/mcp
# Web push (T10). Configuração PÚBLICA do app web do Firebase (JSON com apiKey, projectId, messagingSenderId e appId) e a chave VAPID
# pública. As DUAS juntas ligam o aviso "Ativar notificações"; uma sozinha, ou inválida, só desliga o push (a API sobe e o log cita o nome da
# variável). O JSON pode vir em base64 (recomendado no Easypanel, que pode estragar as aspas). Passo a passo em docs/operacao.md.
# AION_FCM_WEB_CONFIG={"apiKey":"","projectId":"","messagingSenderId":"","appId":""}
# AION_FCM_VAPID_KEY=
# Recuperação do autenticador (TOTP): com true, a API desativa o autenticador ao iniciar e registra a ação na auditoria.
# Use só se perder o celular ou a AION_MASTER_KEY mudar, e REMOVA a variável logo depois (senão desativa a cada reinício).
# AION_TOTP_RESET=false
# Porta da API (padrão 3001), nível de log (padrão info; debug e trace são ignorados em produção) e ambiente.
# PORT=3001
# LOG_LEVEL=info
# NODE_ENV=production

# ---------------------------------------------------------------------------------------------
# worker
# ---------------------------------------------------------------------------------------------
# Executa os bots. Menor privilégio: recebe o banco e a chave mestra (para decifrar a chave do provedor), nunca a credencial do dono.
#   DATABASE_URL e AION_MASTER_KEY: os MESMOS da api (obrigatórias).
#   AION_OPENCODE_GO_BASE_URL, AION_ANTHROPIC_BASE_URL, AION_COMPOSIO_BASE_URL e AION_PARALLEL_BASE_URL: opcionais, os mesmos destinos fixos da api.
#   LOG_LEVEL e NODE_ENV: como acima.
#   AION_FCM_SERVICE_ACCOUNT (T10): SEGREDO. JSON da conta de serviço do Firebase (ou esse JSON em base64), só do worker: é ele quem envia
#   os pushes. Sem ela, os avisos são descartados com um aviso no log. NUNCA coloque o valor neste arquivo nem na api.
#   AION_FCM_BASE_URL e AION_FCM_TOKEN_URL: opcionais, os destinos fixos do FCM (padrão https://fcm.googleapis.com e
#   https://oauth2.googleapis.com/token).
# O worker só começa depois que a api aplicou as migrations (espera até 60 s).

# ---------------------------------------------------------------------------------------------
# web
# ---------------------------------------------------------------------------------------------
# URL interna da API, lida em tempo de execução pelo servidor do Next (padrão http://localhost:3001).
# No Easypanel use o nome interno do serviço, ex.: http://api:3001
# AION_API_INTERNAL_URL=http://localhost:3001
# Mesma AION_PUBLIC_ORIGIN da api (a web usa para HSTS, CSP e o destino do redirect de login). Obrigatória em produção (sem ela
# as páginas respondem 500); fora dela, http://localhost:3000.
# AION_PUBLIC_ORIGIN=https://aion.exemplo.com
